# Let's Encrypt
CERTBOT_EMAIL=your-email@example.com

# API
API_KEY=change-me-to-a-secure-key

# FMCSA
FMCSA_API_KEY=your-fmcsa-webkey-here

# PostgreSQL
POSTGRES_USER=brokerage
POSTGRES_PASSWORD=brokerage_secret
POSTGRES_DB=brokerage
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://brokerage:brokerage_secret@db:5432/brokerage
